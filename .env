# ElevenLabs narration for the quick tour.
#
# NOTE: this file is committed. The key below is therefore public to anyone who
# can read this repository. Rotate it in the ElevenLabs dashboard if it is ever
# misused, and move it to .env.local (gitignored) if you'd rather keep it out of
# version control.
#
# Read only in /api/tts — never expose it through a NEXT_PUBLIC_ var, which
# would ship it to every visitor's browser.
ELEVENLABS_API_KEY=sk_66aa6205ff9fa32350219fa50c45c7af0a5b339afa54082c

# Intended voice: "Bian - Neutral, Calm and Clear" (id-ID, male, educational).
# It is a library/professional voice, which the API only allows on a paid plan;
# on the current free plan it returns 402 and narration falls back to the
# browser voice. Swap the two lines below once the plan is upgraded.
# ELEVENLABS_VOICE_ID=1k39YpzqXZn52BgyLyGO

# Works on the free plan (premade voice) so narration is live today.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
