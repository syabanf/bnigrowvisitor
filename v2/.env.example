# Copy to .env and adjust. Compose falls back to these defaults when unset, so
# `docker compose up` works with no .env at all.

# Host-side ports only — services reach each other over the compose network.
DB_PORT=5440
API_PORT=8090
WEB_PORT=8095

POSTGRES_USER=bni
POSTGRES_PASSWORD=bni_dev_password
POSTGRES_DB=bni_visitor

# REQUIRED. Compose refuses to start without it, and the API rejects both the
# placeholder values and anything under 32 characters in production — a
# predictable signing key means anyone can mint a valid admin session.
#   openssl rand -base64 48
SESSION_SECRET=

APP_ENV=development
# Comma-separated. Must list every origin the SPA is served from, or
# state-changing requests from the real app are rejected as cross-origin.
CORS_ORIGIN=http://localhost:8095,http://localhost:5173

# ElevenLabs narration for the quick tour. Optional — with no key the tour
# narrates using the browser's built-in speech synthesis instead.
# Read only by the API. Never put it in a VITE_ variable: those are inlined
# into the browser bundle and handed to every visitor.
# Note: library/professional voices need a paid plan; free plans get the
# premade voices only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Asisten AI (opsional) ---------------------------------------------------
# Tanpa AI_API_KEY, asisten tetap jalan: ia menjawab langsung dari angka
# dashboard dan mengatakan apa adanya bahwa tidak ada model di belakangnya.
# Endpoint-nya berformat OpenAI chat-completions, jadi DeepSeek, OpenAI, Groq,
# OpenRouter, atau server lokal sama-sama bisa dipakai — cukup ganti URL-nya.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
ASSISTANT_NAME=Grow Assistant

# --- Quick sign-in demo ------------------------------------------------------
# Menerbitkan daftar akun demo di layar login, lengkap dengan passwordnya.
# Biarkan kosong di deployment sungguhan: endpoint-nya menjawab 404 kalau mati,
# jadi tidak ada petunjuk bahwa daftar akun tinggal satu flag lagi.
DEMO_MODE=false
DEMO_PASSWORD=demo123

# --- Production --------------------------------------------------------------
# Set APP_ENV=production dan tiga hal berikut berubah:
#   1. Migrasi data contoh (yang namanya mengandung _seed) dilewati.
#   2. Akun @demo.test yang masih aktif dinonaktifkan saat start, dan dicatat
#      di log. Passwordnya tertulis di README, jadi tidak boleh hidup di host
#      yang bisa dijangkau.
#   3. Pesan penolakan CSRF jadi ringkas, tidak menyebut isi allowlist.
#
# Konsekuensinya database production bersih dari user sama sekali — dua variabel
# di bawah ini yang membuat admin pertama. Dibaca sekali saat start: menjalankan
# ulang tidak membuat akun kedua dan tidak menimpa password yang sudah diganti,
# jadi aman ditinggal terpasang.
APP_ENV=development
SEED_DEMO_DATA=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
