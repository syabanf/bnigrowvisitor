# Copy to .env and adjust. Compose falls back to these defaults when unset, so
# `docker compose up` works with no .env at all.

# Host-side ports only — services reach each other over the compose network.
DB_PORT=5440
API_PORT=8090
WEB_PORT=8095

POSTGRES_USER=bni
POSTGRES_PASSWORD=bni_dev_password
POSTGRES_DB=bni_visitor

# The API refuses to start without this: a predictable signing key means anyone
# can mint a valid admin session. Generate with `openssl rand -base64 32`.
SESSION_SECRET=dev-only-secret-change-me

APP_ENV=development
CORS_ORIGIN=http://localhost:5173
