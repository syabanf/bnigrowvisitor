# Copy to .env and adjust. Compose falls back to these defaults when unset, so
# `docker compose up` works with no .env at all.

# Host-side ports only — services reach each other over the compose network.
DB_PORT=5440
API_PORT=8090
WEB_PORT=8095

POSTGRES_USER=bni
POSTGRES_PASSWORD=bni_dev_password
POSTGRES_DB=bni_visitor

# REQUIRED. Compose refuses to start without it, and the API rejects both the
# placeholder values and anything under 32 characters in production — a
# predictable signing key means anyone can mint a valid admin session.
#   openssl rand -base64 48
SESSION_SECRET=

APP_ENV=development
CORS_ORIGIN=http://localhost:5173
