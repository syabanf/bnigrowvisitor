# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Runs the whole app against an in-memory fake database with seeded data, so no
# Supabase project is needed. Leave this file untouched (or don't create
# .env.local at all) and `npm run dev` boots straight into demo mode.
#
#   true / 1   force demo mode on, even when real credentials are present
#   false / 0  force it off, even when credentials are missing
#   unset      auto: demo mode whenever the two Supabase vars below are empty
DEMO_MODE=

# ---------------------------------------------------------------------------
# Supabase (required for real data — leave blank to stay in demo mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Signs the bni_session cookie. Falls back to SUPABASE_SERVICE_ROLE_KEY when
# unset; demo mode uses a fixed constant.
SESSION_SECRET=

# Powers the BNI Assistant. Without it the assistant UI loads but can't answer.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ElevenLabs narration for the quick tour. Read only in /api/tts — never expose
# the key through a NEXT_PUBLIC_ var. Leave blank and the tour narrates with the
# browser's built-in speech synthesis instead.
# In this repo the real values live in `.env`, which IS committed. Put them in
# `.env.local` instead if you want them kept out of version control.
# Note: library/professional voices require a paid ElevenLabs plan; free plans
# can only use the premade voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Apex domain each chapter subdomain hangs off (e.g. bni-vh.com). Unset means
# auto-domain generation stays dormant.
APP_BASE_DOMAIN=

# Guards the deactivate-overdue-members cron route.
CRON_SECRET=

# Vercel API access for provisioning chapter domains.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
